{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node agent-kickstart/bin/kickstart-state.mjs hook-context",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node agent-kickstart/bin/kickstart-state.mjs session-end",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
